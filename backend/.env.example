APP_NAME=DBAdmin
APP_VERSION=1.0.0
API_PREFIX=/api/v1

APP_HOST=127.0.0.1
APP_PORT=8000

STORAGE_PATH=storage
DB_PATH=storage/dbadmin.db

DB_CONNECT_TIMEOUT=5
QUERY_TIMEOUT_MS=10000
MAX_QUERY_ROWS=1000

POOL_MIN_SIZE=1
POOL_MAX_SIZE=5
POOL_TIMEOUT=5

ALLOWED_NETWORKS=127.0.0.0/8,192.168.0.0/16

FRONTEND_URL=http://localhost:5173

ENCRYPTION_KEY=